# ── Required: your Intuit Developer app credentials ──────────────────────────
# Each deployment needs its OWN Intuit app (developer.intuit.com). These cannot
# be auto-generated.
INTUIT_CLIENT_ID=your_client_id
INTUIT_CLIENT_SECRET=your_client_secret

# sandbox or production
QBO_ENVIRONMENT=sandbox

# ── Public address (all optional — see docs/CUSTOM-DOMAIN.md) ────────────────
# By default the app has no fixed URL: the OAuth issuer, connector metadata,
# QuickBooks callback and upload endpoints all follow whichever domain each
# request arrives on. Point a custom domain at the deployment and it works —
# no redeploy, and the original host keeps working too.
#
# Register https://<each-domain>/callback on your Intuit app's Redirect URIs.
#
# Pin the public origin to ONE address, ignoring the domain actually used.
# Leave unset for the dynamic behaviour above.
# QBO_PUBLIC_URL=https://qbo.yourfirm.com
#
# Allowlist of hostnames this deployment answers on (comma-separated,
# "*.yourfirm.com" wildcards allowed). In dynamic mode the hostname comes from
# a request header; this restricts it to domains you own. Unset = accept any.
# QBO_ALLOWED_HOSTS=qbo.yourfirm.com,myapp.up.railway.app
#
# Pin the QuickBooks callback. Leave unset so it follows the domain in use.
# QBO_REDIRECT_URI=https://qbo.yourfirm.com/callback

# ── Storage ──────────────────────────────────────────────────────────────────
# Path to the SQLite database. In Docker this defaults to /data/qbo-connections.db
# (mount a persistent volume at /data). The auto-generated secrets file lives in
# the same directory.
QBO_DB_PATH=./qbo-connections.db

# Web dashboard + API port (Railway/most hosts set PORT automatically).
QBO_SERVER_PORT=3456

# ── Optional: secrets (auto-generated on first run if left unset) ─────────────
# If you leave these blank, the app generates them on first boot and persists
# them to the data directory (.qbo-secrets.json). The generated admin key is
# printed once in the startup logs. Set them explicitly only if you want to
# manage them yourself (e.g. via your host's secret manager).
#
# IMPORTANT: never change QBO_ENCRYPTION_KEY after companies are connected —
# it decrypts stored tokens; changing it makes every connection unreadable.
QBO_ENCRYPTION_KEY=          # 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QBO_API_KEY=                 # admin key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
