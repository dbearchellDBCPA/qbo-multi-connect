{
  "name": "qbo-multi-connect",
  "version": "0.1.0",
  "description": "AI-agent-first QuickBooks Online multi-client connection tool",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qbo": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/server/public && mkdir -p dist/server/public && cp -r src/server/public/. dist/server/public/ && cp src/db/schema.sql dist/db/schema.sql",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "cli": "tsx src/cli/index.ts",
    "server": "tsx src/server/index.ts",
    "start": "node dist/server/index.js"
  },
  "keywords": [
    "quickbooks",
    "qbo",
    "accounting",
    "oauth",
    "api",
    "multi-tenant"
  ],
  "author": "David Bearchell CPA",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.7.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
